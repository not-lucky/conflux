# Comma-separated OpenAI API keys (optionally with inline per-key proxy: key|proxy_url)
# Example inline: API_KEYS=sk-key1|http://127.0.0.1:8080,sk-key2|socks5://127.0.0.1:1080,sk-key3
API_KEYS=sk-key1,sk-key2,sk-key3,sk-key4,sk-key5

# Optional: Comma-separated proxies matching API_KEYS index 1:1, or single fallback proxy for all keys
# API_PROXIES=http://proxy1:8080,http://proxy2:8080,http://proxy3:8080

# Upstream base URL (OpenAI API)
UPSTREAM_URL=https://api.openai.com

# Port this proxy listens on
PORT=4010

